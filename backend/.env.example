PORT=4000
DATABASE_URL="postgresql://prospector:prospector@localhost:5434/prospector"
GOOGLE_MAPS_API_KEY=""
FRONTEND_URL="http://localhost:5173"
NODE_ENV=development
GEMINI_API_KEY=
# Modelo principal: cria e revisa os sites (análise, direção criativa, layout, copy e código).
GEMINI_MODEL=gemini-3.8-flash
# Modelo barato para tarefas auxiliares (ex.: correção estrutural). Se vazio, usa o GEMINI_MODEL.
GEMINI_AUX_MODEL=gemini-3.5-flash-lite
# Usado somente se o modelo principal retornar sobrecarga após as retentativas.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
# Retentativas com backoff exponencial em 429/5xx/timeout. Nº de tentativas extras após a primeira.
MAX_RETRIES=3
# Sites gerados simultaneamente pela fila de geração (protege contra 429).
MAX_CONCURRENT_GENERATIONS=2
# Chaves opcionais para buscar fotos por categoria. Ordem de uso: Pexels, Pixabay, Unsplash.
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
# Opcional: token do Meta Graph API. Quando presente, busca os assets autorizados
# do Facebook; sem ele o gerador não acessa redes sociais e segue com outros providers.
FACEBOOK_ACCESS_TOKEN=
# ID de uma conta comercial do Instagram vinculada ao app Meta. Necessário para
# Business Discovery pela API oficial; sem ele, o gerador segue sem fotos sociais.
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Máximo de ciclos automáticos de revisão estrutural/visual (0 a 3).
MAX_SITE_REFINEMENT_ITERATIONS=2
# Quando Gemini estiver sobrecarregado, a geração fica pendente e é retomada
# automaticamente. Intervalo em ms e número máximo de novas tentativas.
GEMINI_OVERLOAD_RETRY_MS=60000
MAX_DEFERRED_GENERATION_RETRIES=5
# Envia as fotos reais do lead (Google Maps/Instagram/Facebook/website) para o Gemini
# avaliar visualmente e encaixar cada uma na melhor seção. true (padrão) | false
GEMINI_SEND_IMAGES=true
