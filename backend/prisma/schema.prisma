generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  NOVO
  CONTATADO
  RESPONDEU
  INTERESSADO
  NEGOCIACAO
  CLIENTE
  IGNORADO
}

enum LeadSource {
  PROSPECCAO
  ENRIQUECIMENTO
}

enum CrmStage {
  SCHEDULED
  FOLLOW_UP
  NEW
  SITE_GENERATED
  MESSAGE_SENT
  REPLIED
  INTERESTED
  NEGOTIATION
  CLIENT
  LOST
}

enum CrmActivityType {
  ADDED_TO_CRM
  MESSAGE_SENT
  STAGE_CHANGED
  NOTE_ADDED
  FOLLOW_UP_CREATED
  WHATSAPP_OPENED
  CLIENT_WON
  LOST
}

model Lead {
  id                    String       @id @default(cuid())
  googlePlaceId         String       @unique
  nome                  String
  categoria             String?
  nicho                 String?
  endereco              String?
  cidade                String?
  estado                String?
  cep                   String?
  latitude              Float?
  longitude             Float?
  telefone              String?
  telefoneInternacional String?
  site                  String?
  googleMapsUrl         String?
  nota                  Float?
  quantidadeAvaliacoes  Int?
  businessStatus        String?
  status                Status       @default(NOVO)
  observacoes           String?
  leadScore             Int          @default(0)
  source                LeadSource   @default(PROSPECCAO)
  lastEnrichedAt        DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  campaigns             CampaignLead[]
  crmLead               CrmLead?
}

model Campaign {
  id                   String          @id @default(cuid())
  nome                 String
  nicho                String
  cidade               String
  estado               String
  quantidadeSolicitada Int
  quantidadeEncontrada Int             @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  leads                CampaignLead[]
}

model CampaignLead {
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId     String
  campaignId String

  @@id([leadId, campaignId])
  @@index([campaignId])
}

model MessageTemplate {
  id        String   @id @default(cuid())
  nome      String
  conteudo  String
  servico   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model CrmLead {
  id             String        @id @default(cuid())
  leadId         String        @unique
  lead           Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stage          CrmStage      @default(NEW)
  position       Int           @default(0)
  notes          String?
  lastContactAt  DateTime?
  nextFollowUpAt DateTime?
  activities     CrmActivity[]
  website        Website?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([stage, position])
}

model Website {
  id               String @id @default(cuid())
  crmLeadId        String @unique
  crmLead          CrmLead @relation(fields: [crmLeadId], references: [id], onDelete: Cascade)
  name             String
  business         Json
  theme            Json
  seo              Json?
  sections         WebsiteSection[]
  status           String @default("DRAFT")
  generationStatus String @default("pending")
  generationError  String?
  revision         Int @default(0)
  published        Json?
  publishedAt      DateTime?
  schemaVersion    Int @default(1)
  currentDocument  Json?
  versions         WebsiteVersion[]
  assets           WebsiteAsset[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model WebsiteVersion {
  id        String   @id @default(cuid())
  websiteId String
  website   Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  version   Int
  document  Json
  source    String
  createdAt DateTime @default(now())

  @@unique([websiteId, version])
  @@index([websiteId, createdAt])
}

model WebsiteAsset {
  id         String   @id @default(cuid())
  websiteId  String
  website    Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  provider   String
  providerId String?
  url        String
  purpose    String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([websiteId, purpose])
}

model WebsiteSection {
  id        String @id @default(cuid())
  websiteId String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  type      String
  order     Int
  visible   Boolean @default(true)
  content   Json
  settings  Json

  @@index([websiteId, order])
}

model CrmActivity {
  id          String          @id @default(cuid())
  crmLeadId   String
  crmLead     CrmLead         @relation(fields: [crmLeadId], references: [id], onDelete: Cascade)
  type        CrmActivityType
  description String
  createdAt   DateTime        @default(now())

  @@index([crmLeadId, createdAt])
}
